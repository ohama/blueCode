<task type="auto">
  <name>Task 3: PlanGateTests.fs — keystroke dispatch + renderPlan output assertions; live smoke for SC1/SC2/SC3/SC4</name>
  <files>tests/BlueCode.Tests/PlanGateTests.fs, tests/BlueCode.Tests/BlueCode.Tests.fsproj, tests/BlueCode.Tests/RouterTests.fs</files>
  <action>
**Step 1.** Create `tests/BlueCode.Tests/PlanGateTests.fs` with ≥4 testCases. Mirror the SessionStoreTests pattern (`testSequenced` because tests touch Console.SetIn / Console.SetOut globals). Key insight from CLAUDE.md: any test mutating `Console.SetOut`/`Console.SetIn` MUST be in a `testSequenced` block.

```fsharp
module BlueCode.Tests.PlanGateTests

open System
open System.IO
open Expecto
open BlueCode.Core.Domain
open BlueCode.Cli.PlanGate
open BlueCode.Tests.MockHelpers

// ── Helpers ──────────────────────────────────────────────────────────────────

/// Build a small, valid Plan for rendering / approval tests.
let private samplePlan : Plan =
    { Steps =
        [ makePlannedStep "list_dir" """{"path":"."}""" "see top-level"
          makePlannedStep "read_file" """{"path":"README.md"}""" "read project doc" ]
      Rationale = "list then read to satisfy the request" }

/// Redirect Console.In to a string for one test, restoring afterwards.
let private withStdin (input: string) (action: unit -> 'a) : 'a =
    let originalIn = Console.In
    let originalOut = Console.Out
    let outBuf = new StringWriter()
    use reader = new StringReader(input)
    Console.SetIn(reader)
    Console.SetOut(outBuf)
    try
        action ()
    finally
        Console.SetIn(originalIn)
        Console.SetOut(originalOut)

// ── Tests ────────────────────────────────────────────────────────────────────

let tests =
    testSequenced
    <| testList
        "PlanGate"
        [
          testCase "renderPlan: produces table with one row per step + Rationale line"
          <| fun () ->
              let rendered = renderPlan samplePlan
              Expect.isGreaterThan rendered.Length 0 "rendering is non-empty"
              Expect.stringContains rendered "list_dir" "step 1 tool name appears"
              Expect.stringContains rendered "read_file" "step 2 tool name appears"
              Expect.stringContains rendered "see top-level" "step 1 rationale appears"
              Expect.stringContains rendered "read project doc" "step 2 rationale appears"
              Expect.stringContains rendered "list then read to satisfy the request" "top-level Rationale appears"

          testCase "readApprovalKey: 'a' input → Accept"
          <| fun () ->
              let result = withStdin "a\n" (fun () -> readApprovalKey ())
              Expect.equal result Accept "single 'a' maps to Accept"

          testCase "readApprovalKey: 'r' input → Reject"
          <| fun () ->
              let result = withStdin "r\n" (fun () -> readApprovalKey ())
              Expect.equal result Reject "single 'r' maps to Reject"

          testCase "readApprovalKey: 'q' input → Quit"
          <| fun () ->
              let result = withStdin "q\n" (fun () -> readApprovalKey ())
              Expect.equal result Quit "single 'q' maps to Quit"

          testCase "readApprovalKey: 'e' followed by comment line → Edit comment"
          <| fun () ->
              let result = withStdin "e\nplease tighten step 2\n" (fun () -> readApprovalKey ())
              match result with
              | Edit comment ->
                  Expect.equal comment "please tighten step 2" "edit comment captured verbatim"
              | other -> failtestf "Expected Edit, got %A" other

          testCase "readApprovalKey: unknown char then 'a' → Accept after re-prompt"
          <| fun () ->
              // First line: 'x' → re-prompt; second line: 'a' → Accept.
              let result = withStdin "x\na\n" (fun () -> readApprovalKey ())
              Expect.equal result Accept "junk-then-valid input still resolves to Accept"

          testCase "renderPlan: input preview truncates at 60 chars with ellipsis"
          <| fun () ->
              // Build a step whose _raw input is > 60 chars.
              let longRaw = """{"path":"a/very/long/path/that/exceeds/the/sixty-character/preview/limit"}"""
              let plan : Plan =
                  { Steps = [ makePlannedStep "read_file" longRaw "long path test" ]
                    Rationale = "x" }
              let rendered = renderPlan plan
              // Rendered string should NOT contain the full longRaw substring; should contain a "..." marker.
              Expect.isFalse (rendered.Contains(longRaw)) "rendered preview does NOT contain full long input"
              Expect.stringContains rendered "..." "rendered preview ends with ellipsis"
        ]
```

