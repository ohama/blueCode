**Smoke C — SC4 --plan --resume:**

```bash
# First, create a session by running a regular single-turn invocation.
SETUP_OUT=$(dotnet run --project src/BlueCode.Cli/BlueCode.Cli.fsproj -c Release -- "what is 2 plus 2" 2>/tmp/bc-16-smoke/setup.err)
SESSION_ID=$(grep -E "^Session: " /tmp/bc-16-smoke/setup.err | head -1 | awk '{print $2}')
test -n "$SESSION_ID" || { echo "FAIL SC4 setup: no session id"; exit 1; }

# Now resume in plan mode.
printf 'q\n' | dotnet run --project src/BlueCode.Cli/BlueCode.Cli.fsproj -c Release -- --plan --resume "$SESSION_ID" "show me what we did" \
    > /tmp/bc-16-smoke/resume-plan.stdout 2> /tmp/bc-16-smoke/resume-plan.stderr
RC=$?
test "$RC" = "0" || { echo "FAIL SC4: exit $RC"; exit 1; }
grep -E "^Session: $SESSION_ID" /tmp/bc-16-smoke/resume-plan.stderr > /dev/null || { echo "FAIL SC4: session id not preserved on resume"; exit 1; }
echo "PASS SC4: --plan --resume valid combination"
