- `BlueCode.Cli.Rendering` (renderStep, RenderMode)
- `Serilog` (for Log.Debug/Information optional)

```fsharp
module BlueCode.Cli.PlanGate

open System
open System.IO
open System.Threading
open System.Threading.Tasks
open Spectre.Console
open BlueCode.Core.Domain
open BlueCode.Core.Ports
open BlueCode.Core.AgentLoop
open BlueCode.Cli.CompositionRoot
open BlueCode.Cli.Rendering
open BlueCode.Cli.Adapters.JsonlSink

// ── ApprovalAction DU ────────────────────────────────────────────────────────

/// User's choice at the plan-approval gate. The Edit case carries the
/// free-text comment captured via Console.ReadLine.
type ApprovalAction =
    | Accept
    | Reject
    | Edit of comment: string
    | Quit

// ── Plan rendering (PURE) ────────────────────────────────────────────────────

/// Render a Plan as a numbered Spectre table (#, Tool, Input preview, Rationale)
/// plus a top-level Rationale line. Returns the rendered string so tests can
/// assert on its content (Spectre auto-detects non-TTY and emits plain text).
///
/// Input preview: max 60 chars of the per-step _raw input JSON; longer truncated
/// with "..." suffix. The full _raw is stored on the PlannedStep — preview is
/// for table density only.
///
/// PUBLIC: tested by PlanGateTests directly. Pure function (no I/O); the
/// AnsiConsole.Console binding to a StringWriter is the standard Spectre
/// off-screen rendering pattern.
let renderPlan (plan: Plan) : string =
    let writer = new StringWriter()
    let console = AnsiConsole.Create(AnsiConsoleSettings(Out = AnsiConsoleOutput(writer)))
    let table = Table()
    table.AddColumn("#")  |> ignore
    table.AddColumn("Tool") |> ignore
    table.AddColumn("Input preview") |> ignore
    table.AddColumn("Rationale") |> ignore

    plan.Steps
    |> List.iteri (fun i ps ->
        let (ToolName tname) = ps.Tool
        let (ToolInput m) = ps.Input
        let raw = m |> Map.tryFind "_raw" |> Option.defaultValue "{}"
        let preview =
            if raw.Length > 60 then raw.Substring(0, 57) + "..." else raw
        // Spectre.Console treats [foo] as markup; escape [ and ] in user data.
        let escapeMarkup (s: string) = s.Replace("[", "[[").Replace("]", "]]")
        table.AddRow(
            string (i + 1),
            escapeMarkup tname,
            escapeMarkup preview,
            escapeMarkup ps.Rationale
        ) |> ignore)

    console.Write(table)
    let escapedRat = plan.Rationale.Replace("[", "[[").Replace("]", "]]")
    console.MarkupLine(sprintf "Rationale: %s" escapedRat)
    writer.ToString()

// ── Keystroke dispatch (IMPURE — Console.ReadKey + ReadLine) ─────────────────

/// Read a single keystroke and map it to an ApprovalAction. On 'a'/'r'/'q'
/// returns immediately. On 'e' calls Console.ReadLine to capture the edit
/// comment (echoed). On any other key, re-prompts up to 5 attempts before
/// defaulting to Quit (defensive against pasted junk).
///
/// Console.ReadKey(intercept=true) suppresses echo so the menu prompt isn't
/// polluted by the keystroke. ReadLine for edit comments DOES echo by design.
///
/// PUBLIC: tested by PlanGateTests via Console.SetIn redirection.
let readApprovalKey () : ApprovalAction =
    let rec loop attempts =
        if attempts <= 0 then
            Quit
        else
            printf "[a]ccept / [r]eject / [e]dit / [q]uit > "
            // Console.ReadKey throws on redirected input (test scenario where SetIn used);
            // tests must use Console.In.Read() path. We support both: try ReadKey, fall
            // back to ReadLine first character on failure.
            let chOpt =
                try
                    let key = Console.ReadKey(intercept = true)
                    printfn "%c" key.KeyChar  // echo our chosen char so the user sees the choice
                    Some (Char.ToLower(key.KeyChar))
                with _ ->
                    // Redirected stdin (test). Read a line and take its first non-whitespace char.
                    let line = Console.ReadLine()
                    if isNull line || line.Length = 0 then None
                    else Some (Char.ToLower(line.[0]))
            match chOpt with
            | Some 'a' -> Accept
            | Some 'r' -> Reject
            | Some 'q' -> Quit
            | Some 'e' ->
                printf "edit comment > "
                let comment = Console.ReadLine() |> Option.ofObj |> Option.defaultValue ""
                Edit comment
            | _ ->
                printfn "Unknown key; expected one of a/r/e/q."
                loop (attempts - 1)
    loop 5

// ── Per-step dispatch helper (replicates AgentLoop.dispatchTool, kept LOCAL) ─

/// Mirrors AgentLoop.dispatchTool's 7-arm match (which is `let private` in Core
/// and intentionally so). Replicating here avoids a leaky public export. Failure
/// mode: returns Error(UnknownTool ...) for any tool name not in the registry —
/// PlanValidator already rejects unknown tools so this should never fire after
/// validatePlan, but the defensive branch is present for safety.
let private dispatchPlannedStep (ps: PlannedStep) : Result<Tool, AgentError> =
    let (ToolName name) = ps.Tool
    let (ToolInput m) = ps.Input
    let raw = m |> Map.tryFind "_raw" |> Option.defaultValue "{}"
    // Reuse the existing per-tool input parsers via a single JSON pass.
    // The simplest path: build an LlmStep-like JsonElement and call into
    // the existing per-tool input parser. But that infrastructure isn't
    // exposed. Defer to a stripped-down path: each tool's required fields
    // are known; parse them directly with System.Text.Json.
    use doc = System.Text.Json.JsonDocument.Parse(raw)
    let root = doc.RootElement
    let getStr field =
        match root.TryGetProperty(field) with
        | true, v when v.ValueKind = System.Text.Json.JsonValueKind.String -> Some (v.GetString())
        | _ -> None
    let getInt field =
        match root.TryGetProperty(field) with
        | true, v when v.ValueKind = System.Text.Json.JsonValueKind.Number ->
            let mutable i = 0
            if v.TryGetInt32(&i) then Some i else None
        | _ -> None
    match name with
    | "read_file" ->
        match getStr "path" with
        | Some p ->
            let range =
                match getInt "start_line", getInt "end_line" with
                | Some s, Some e -> Some (s, e)
                | _ -> None
            Ok (ReadFile (FilePath p, range))
        | None -> Error (UnknownTool ps.Tool)
    | "write_file" ->
        match getStr "path", getStr "content" with
        | Some p, Some c -> Ok (WriteFile (FilePath p, c))
        | _ -> Error (UnknownTool ps.Tool)
    | "list_dir" ->
        match getStr "path" with
        | Some p -> Ok (ListDir (FilePath p, getInt "depth"))
        | None -> Error (UnknownTool ps.Tool)
    | "run_shell" ->
        match getStr "command" with
        | Some c -> Ok (RunShell (c, getInt "timeout_ms"))
        | None -> Error (UnknownTool ps.Tool)
    | "edit_file" ->
        match getStr "path", getStr "old_string", getStr "new_string" with
        | Some p, Some o, Some n -> Ok (EditFile (FilePath p, o, n))
        | _ -> Error (UnknownTool ps.Tool)
    | "glob_search" ->
        match getStr "pattern" with
        | Some pat -> Ok (GlobSearch (pat, getStr "path"))
        | None -> Error (UnknownTool ps.Tool)
    | "grep_search" ->
        match getStr "pattern" with
        | Some pat -> Ok (GrepSearch (pat, getStr "path", getStr "file_glob"))
        | None -> Error (UnknownTool ps.Tool)
    | _ -> Error (UnknownTool ps.Tool)

// IMPORTANT: If the actual Tool DU constructors above don't match
// (e.g. arity mismatch with current FsToolExecutor), the implementer
// MUST inspect src/BlueCode.Core/Domain.fs for the exact Tool DU shape
// and adjust. The dispatch logic above is a best-effort skeleton; the
// actual arity may differ. Ground truth: src/BlueCode.Core/AgentLoop.fs
// `dispatchTool` (line ~36) shows the exact constructor calls in use.

// ── Top-level orchestrator ───────────────────────────────────────────────────

/// Drive plan-mode for one user prompt. Loop:
///   1. runPlanTurn → validated Plan (or Error → surface).
///   2. renderPlan + readApprovalKey.
///   3. Accept → execute steps, return (0, newSteps).
///      Reject → re-call runPlanTurn with userInput + "\n[PLAN REJECTED]" → goto 2.
///      Edit c → re-call runPlanTurn with userInput + "\n[PLAN EDIT NOTE: " + c + "]" → goto 2.
///      Quit → return (0, []).
///
/// On a non-PlanInvalid AgentError from runPlanTurn (LlmUnreachable etc.),
/// returns (1, []) and prints the error via renderError on stderr.
///
/// On PlanInvalid (3 attempts exhausted in runPlanTurn), returns (1, []) and
/// prints "ERROR: plan invalid: <detail>" on stderr (no stack trace).
///
/// PUBLIC: called from Program.fs when opts.PlanMode is true.
let runPlanGate
    (components: AppComponents)
    (renderMode: RenderMode)
    (userInput: string)
    (priorSteps: Step list)
    : Task<int * Step list> =
    task {
        use cts = new CancellationTokenSource()
        let cancelHandler =
            ConsoleCancelEventHandler(fun _ args ->
                args.Cancel <- true
                cts.Cancel())
        Console.CancelKeyPress.AddHandler(cancelHandler)

        let mutable currentPrompt = userInput
        let mutable cumulativeNewSteps : Step list = []
        let mutable result : (int * Step list) option = None

        try
            while result.IsNone do
                let! planResult = runPlanTurn components.Config components.LlmClient priorSteps currentPrompt cts.Token
                match planResult with
                | Error (PlanInvalid detail) ->
                    eprintfn "ERROR: plan invalid: %s" detail
                    result <- Some (1, cumulativeNewSteps)
                | Error e ->
                    eprintfn "%s" (renderError e)
                    result <- Some (1, cumulativeNewSteps)
                | Ok plan ->
                    let rendered = renderPlan plan
                    printfn "%s" rendered
                    let action = readApprovalKey ()
                    match action with
                    | Quit ->
                        printfn "Quit; no tools executed."
                        result <- Some (0, cumulativeNewSteps)
                    | Reject ->
                        currentPrompt <- userInput + "\n\n[PLAN REJECTED]"
                        // loop continues
                    | Edit comment ->
                        currentPrompt <- userInput + "\n\n[PLAN EDIT NOTE: " + comment + "]"
                        // loop continues
                    | Accept ->
                        // Execute the plan's Steps in order. Each step builds a Step record
                        // for JSONL persistence + rendering parity with runSingleTurn.
                        let mutable execAborted = false
                        let mutable stepNum = 1 + List.length priorSteps
                        for ps in plan.Steps do
                            if not execAborted then
                                let startedAt = DateTimeOffset.UtcNow
                                match dispatchPlannedStep ps with
                                | Error e ->
                                    // Should never fire after PlanValidator, but defensive.
                                    eprintfn "%s" (renderError e)
                                    execAborted <- true
                                | Ok tool ->
                                    let! toolRes = components.ToolExecutor.ExecuteAsync tool cts.Token
                                    let endedAt = DateTimeOffset.UtcNow
                                    let durMs = int64 (endedAt - startedAt).TotalMilliseconds
                                    match toolRes with
                                    | Error e ->
                                        eprintfn "%s" (renderError e)
                                        execAborted <- true
                                    | Ok tr ->
                                        let status =
                                            match tr with
                                            | Success _ -> StepSuccess
                                            | _ -> StepFailed "plan-step failure"
                                        let stepRec : Step =
                                            { StepNumber = stepNum
                                              Thought = Thought ps.Rationale
                                              Action = ToolCall (ps.Tool, ps.Input)
                                              ToolResult = Some tr
                                              Status = status
                                              ModelUsed =
                                                  components.Config.ForcedModel
                                                  |> Option.defaultValue Qwen32B
                                              StartedAt = startedAt
                                              EndedAt = endedAt
                                              DurationMs = durMs }
                                        components.JsonlSink.WriteStep stepRec
                                        printfn "%s" (renderStep renderMode stepRec)
                                        cumulativeNewSteps <- cumulativeNewSteps @ [stepRec]
                                        stepNum <- stepNum + 1
                        if execAborted then
                            result <- Some (1, cumulativeNewSteps)
                        else
                            result <- Some (0, cumulativeNewSteps)
            return result.Value
        finally
            Console.CancelKeyPress.RemoveHandler(cancelHandler)
    }
```

**IMPLEMENTATION NOTE on dispatchPlannedStep**: The code above is a SKELETON for the 7-arm tool dispatch. Before executing this task, the implementer MUST open `src/BlueCode.Core/AgentLoop.fs` lines 36-122 (the existing private `dispatchTool` function) and copy its EXACT input-parsing logic into `dispatchPlannedStep`, adjusting only for the fact that the input arrives as a `ToolInput(_raw)` map rather than a `JsonElement`. The two share the same JSON shape so the parsing logic is identical. Do NOT invent new parsing rules — mirror `dispatchTool` exactly.

If `dispatchTool` already accepts a `ToolInput` value (verify by reading it), the cleanest fix is to make `dispatchTool` `let` (public) instead of `let private` and call it directly from PlanGate — but ONLY do this if the change is a one-line visibility flip with no other ramifications. Otherwise replicate.

