**Smoke A — SC1 + SC2 (Accept path):**

```bash
# Pipe 'a' to stdin to accept whatever plan the LLM proposes.
# Capture stdout (should contain plan table) and stderr (should contain Session id + final answer rendering).
printf 'a\n' | dotnet run --project src/BlueCode.Cli/BlueCode.Cli.fsproj -c Release -- --plan "list 3 files in src" \
    > /tmp/bc-16-smoke/accept.stdout 2> /tmp/bc-16-smoke/accept.stderr
RC=$?
echo "exit code: $RC"
head -40 /tmp/bc-16-smoke/accept.stdout
echo '---STDERR---'
head -10 /tmp/bc-16-smoke/accept.stderr

# Assertions for SC1: stdout contains a table with [a]ccept prompt before any tool execution.
grep -q "\[a\]ccept" /tmp/bc-16-smoke/accept.stdout || { echo "FAIL SC1: prompt not displayed"; exit 1; }
grep -q "Tool" /tmp/bc-16-smoke/accept.stdout || { echo "FAIL SC1: no Tool column header"; exit 1; }
grep -q "Rationale" /tmp/bc-16-smoke/accept.stdout || { echo "FAIL SC1: no Rationale column or line"; exit 1; }
echo "PASS SC1: rendered table + prompt displayed"

# Assertions for SC2 accept: exit 0, at least one step persisted.
test "$RC" = "0" || { echo "FAIL SC2 accept: exit was $RC, expected 0"; exit 1; }
echo "PASS SC2 accept: exit 0"
```

