**Step 1.** Create `tests/BlueCode.Tests/PlanParseTests.fs` with ≥6 testCases covering the parse pipeline and the retry path. Use `MockHelpers.makeMockResponse` / `makePlanResponse` / `makePlannedStep` (all already exist in `tests/BlueCode.Tests/MockHelpers.fs` from Phase 14).

**Module-visibility ground truth** (verified against current codebase before this plan was written):
- `LlmStep` is declared in `src/BlueCode.Cli/Adapters/LlmWire.fs` line 22, in module `BlueCode.Cli.Adapters.LlmWire`. To reference it as the bare name `LlmStep` we must `open BlueCode.Cli.Adapters.LlmWire`.
- `jsonOptions` is declared in `src/BlueCode.Cli/Adapters/Json.fs` line 32 as `let jsonOptions: JsonSerializerOptions = ...` — it is **module-public** (no `private` modifier). To reference it as the bare name `jsonOptions` we must `open BlueCode.Cli.Adapters.Json`.
- `toLlmOutput` is declared in `src/BlueCode.Cli/Adapters/QwenHttpClient.fs` line 171 as `let toLlmOutput` — module-public. To reference it as the bare name we must `open BlueCode.Cli.Adapters.QwenHttpClient`.
- The canonical pattern in this repo for accessing these three identifiers is shown by `tests/BlueCode.Tests/ToLlmOutputTests.fs` lines 6-7, which opens `BlueCode.Cli.Adapters.LlmWire` and `BlueCode.Cli.Adapters.QwenHttpClient` directly. Follow that pattern.

The opens block below uses the three explicit submodule opens (NOT `open BlueCode.Cli.Adapters` — opening the parent namespace alone does NOT bring submodule contents into the unqualified namespace).

```fsharp
module BlueCode.Tests.PlanParseTests

open System
open System.Text.Json
open System.Threading
open System.Threading.Tasks
open Expecto
open BlueCode.Core.Domain
open BlueCode.Core.Ports
open BlueCode.Core.AgentLoop
open BlueCode.Cli.Adapters.LlmWire        // for LlmStep type
open BlueCode.Cli.Adapters.Json            // for jsonOptions
open BlueCode.Cli.Adapters.QwenHttpClient  // for toLlmOutput function
open BlueCode.Tests.MockHelpers

// ── Helpers ──────────────────────────────────────────────────────────────────

/// Build an LlmStep value from raw JSON content for direct toLlmOutput testing.
/// Mirrors the path inside parseLlmResponse (extract → schema → deserialize) but
/// we shortcut to deserialize here because we control the input shape exactly.
let private mkStep (json: string) : LlmStep =
    JsonSerializer.Deserialize<LlmStep>(json, jsonOptions)

/// Construct a simple LlmStep DOM whose action is "plan" and whose input is
/// the supplied JSON string (parsed as a JsonElement).
///
/// Implementation: we synthesize the full {thought, action, input} envelope as
/// a string and deserialize it through the SAME JsonSerializer + jsonOptions
/// the production code uses (Json.fs line 32). LlmStep is the public adapter-layer
/// type from LlmWire.fs (line 22) and jsonOptions is module-public so this call
/// is well-formed without further indirection.
let private mkPlanStep (inputJson: string) : LlmStep =
    let fullJson = sprintf """{"thought":"plan reasoning","action":"plan","input":%s}""" inputJson
    JsonSerializer.Deserialize<LlmStep>(fullJson, jsonOptions)

// Stub LLM that returns a queue of canned responses. Used for retry-behavior tests.
let private mkScriptedLlm (responses: Result<LlmResponse, AgentError> list) : ILlmClient =
    let q = System.Collections.Generic.Queue<Result<LlmResponse, AgentError>>(responses)
    { new ILlmClient with
        member _.CompleteAsync _messages _model _ct =
            if q.Count = 0 then failwith "scripted LLM: queue exhausted"
            Task.FromResult(q.Dequeue()) }

let private testConfig : AgentConfig =
    { MaxLoops = 5
      ContextCapacity = 3
      SystemPrompt = "test prompt"
      ForcedModel = Some Qwen32B }

// ── Tests ────────────────────────────────────────────────────────────────────

let tests =
    testList
        "PlanParse"
        [
          // ===== JSON parse-layer tests (toLlmOutput Plan branch) =====

          testCase "happy path: valid plan input parses to LlmOutput.Plan with correct Steps + Rationale"
          <| fun () ->
              let step =
                  mkPlanStep """{
                      "steps": [
                          {"tool": "list_dir", "input": {"path": "."}, "rationale": "see top-level"},
                          {"tool": "read_file", "input": {"path": "README.md"}, "rationale": "read project doc"}
                      ],
                      "rationale": "to answer the user's request we list then read"
                  }"""
              match toLlmOutput step with
              | Ok { Output = LlmOutput.Plan p } ->
                  Expect.equal p.Steps.Length 2 "two steps parsed"
                  Expect.equal p.Steps.[0].Tool (ToolName "list_dir") "first step tool"
                  Expect.equal p.Steps.[1].Tool (ToolName "read_file") "second step tool"
                  Expect.equal p.Rationale "to answer the user's request we list then read" "rationale parsed"
                  let (ToolInput m0) = p.Steps.[0].Input
                  Expect.isTrue (Map.containsKey "_raw" m0) "step 0 input wrapped in _raw passthrough"
              | other -> failtestf "Expected Ok(Plan), got %A" other

          testCase "schema-invalid: missing 'steps' field returns PlanInvalid"
          <| fun () ->
              let step = mkPlanStep """{"rationale": "no steps here"}"""
              match toLlmOutput step with
              | Error (PlanInvalid detail) ->
                  Expect.stringContains detail "steps" "PlanInvalid mentions the missing field"
              | other -> failtestf "Expected PlanInvalid, got %A" other

          testCase "schema-invalid: 'steps' not an array returns PlanInvalid"
          <| fun () ->
              let step = mkPlanStep """{"steps": "not an array", "rationale": "x"}"""
              match toLlmOutput step with
              | Error (PlanInvalid detail) ->
                  Expect.stringContains detail "array" "PlanInvalid mentions array constraint"
              | other -> failtestf "Expected PlanInvalid, got %A" other

          testCase "schema-invalid: missing 'rationale' field returns PlanInvalid"
          <| fun () ->
              let step = mkPlanStep """{"steps": [{"tool":"list_dir","input":{"path":"."},"rationale":"x"}]}"""
              match toLlmOutput step with
              | Error (PlanInvalid detail) ->
                  Expect.stringContains detail "rationale" "PlanInvalid mentions the missing field"
              | other -> failtestf "Expected PlanInvalid, got %A" other

          testCase "schema-invalid: per-step missing 'tool' field returns PlanInvalid with index"
          <| fun () ->
              let step = mkPlanStep """{
                  "steps": [
                      {"tool":"list_dir","input":{"path":"."},"rationale":"ok"},
                      {"input":{"path":"x"},"rationale":"missing tool"}
                  ],
                  "rationale": "x"}"""
              match toLlmOutput step with
              | Error (PlanInvalid detail) ->
                  Expect.stringContains detail "steps[1]" "PlanInvalid identifies the offending step index"
                  Expect.stringContains detail "tool" "PlanInvalid mentions the missing field"
              | other -> failtestf "Expected PlanInvalid, got %A" other

          // ===== runPlanTurn retry-path tests =====

          testCase "runPlanTurn: validator failure retries; second attempt succeeds → returns Ok"
          <| fun () ->
              // First response: a plan with 6 steps (validator rejects: >5).
              // Second response: a valid 2-step plan.
              let badPlan : Plan =
                  { Steps = [ for i in 1 .. 6 -> makePlannedStep "list_dir" (sprintf """{"path":"%d"}""" i) "" ]
                    Rationale = "too many" }
              let goodPlan : Plan =
                  { Steps = [
                        makePlannedStep "list_dir" """{"path":"."}""" "list"
                        makePlannedStep "read_file" """{"path":"README.md"}""" "read" ]
                    Rationale = "fine" }
              let llm = mkScriptedLlm [ makePlanResponse "first try" badPlan; makePlanResponse "second try" goodPlan ]
              let result = (runPlanTurn testConfig llm [] "list and read" CancellationToken.None).GetAwaiter().GetResult()
              match result with
              | Ok p ->
                  Expect.equal p.Steps.Length 2 "second-attempt plan returned"
                  Expect.equal p.Rationale "fine" "rationale from second-attempt plan"
              | Error e -> failtestf "Expected Ok after retry, got %A" e

          testCase "runPlanTurn: 3 consecutive PlanInvalid returns Error(PlanInvalid \"...after 3 attempts\")"
          <| fun () ->
              // All three responses are 6-step plans (validator rejects).
              let badPlan : Plan =
                  { Steps = [ for i in 1 .. 6 -> makePlannedStep "list_dir" (sprintf """{"path":"%d"}""" i) "" ]
                    Rationale = "too many" }
              let llm = mkScriptedLlm [
                  makePlanResponse "try 1" badPlan
                  makePlanResponse "try 2" badPlan
                  makePlanResponse "try 3" badPlan ]
              let result = (runPlanTurn testConfig llm [] "do something" CancellationToken.None).GetAwaiter().GetResult()
              match result with
              | Error (PlanInvalid detail) ->
                  Expect.stringContains detail "3 attempts" "error mentions exhausted attempt count"
              | other -> failtestf "Expected Error(PlanInvalid ... 3 attempts), got %A" other

          testCase "runPlanTurn: LLM emits non-plan output (FinalAnswer) → retry; second attempt with Plan → Ok"
          <| fun () ->
              let goodPlan : Plan =
                  { Steps = [ makePlannedStep "list_dir" """{"path":"."}""" "list" ]
                    Rationale = "fine" }
              let llm = mkScriptedLlm [
                  makeMockResponse "wrong" (FinalAnswer "I think it's 42")
                  makePlanResponse "right" goodPlan ]
              let result = (runPlanTurn testConfig llm [] "what?" CancellationToken.None).GetAwaiter().GetResult()
              match result with
              | Ok p -> Expect.equal p.Steps.Length 1 "recovered with valid plan"
              | Error e -> failtestf "Expected Ok after retry from non-plan output, got %A" e

          testCase "runPlanTurn: LlmUnreachable surfaces immediately, no retry"
          <| fun () ->
              let llm = mkScriptedLlm [ Error (LlmUnreachable("http://x", "connection refused")) ]
              let result = (runPlanTurn testConfig llm [] "x" CancellationToken.None).GetAwaiter().GetResult()
              match result with
              | Error (LlmUnreachable _) -> ()  // expected — non-PlanInvalid error skips retry
              | other -> failtestf "Expected immediate LlmUnreachable, got %A" other
        ]
```

